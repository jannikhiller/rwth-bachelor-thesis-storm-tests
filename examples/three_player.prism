smg

player triangle mt endplayer
player circle mc endplayer
player square ms endplayer

global state : [0..9];

module mt
  [] state=0 -> 1/2 : (state'=0) + 1/2 : (state'=1);
  [] state=1 -> 1/2 : (state'=2) + 1/2 : (state'=5);
  [] state=1 -> (state'=4);
  [] state=3 -> (state'=3);
  [] state=8 -> 1/2 : (state'=4) + 1/2 : (state'=7);
endmodule

module mc
  [] state=2 -> (state'=3);
endmodule

module ms
  [] state=4 -> (state'=4);
  [] state=4 -> (state'=7);
  [] state=4 -> 1/3 : (state'=5) + 1/3 : (state'=8) + 1/3 : (state'=6);
  [] state=6 -> 1/2 : (state'=2) + 1/2 : (state'=3);
  [] state=6 -> 1/2 : (state'=4) + 1/2 : (state'=7);
  [] state=6 -> (state'=9);
  [] state=7 -> 1/3 : (state'=6) + 1/3 : (state'=8) + 1/3 : (state'=9);
endmodule
