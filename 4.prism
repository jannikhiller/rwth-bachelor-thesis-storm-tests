smg

player tri m_tri endplayer
player cir m_cir endplayer
player sqr m_sqr endplayer

global state : [0..9] init 6;

module m_tri
  [] state=0 -> 1/2 : (state'=0) + 1/2 : (state'=1);
  [] state=1 -> 1/2 : (state'=2) + 1/2 : (state'=5);
  [] state=1 -> (state'=4);
  [] state=3 -> (state'=3);
  [] state=8 -> 1/2 : (state'=4) + 1/2 : (state'=7);
endmodule

module m_cir
  [] state=2 -> (state'=3);
endmodule

module m_sqr
  [] state=4 -> (state'=4);
  [] state=4 -> (state'=7);
  [] state=6 -> (state'=9);
  [] state=4 -> 1/3 : (state'=8) + 1/3 : (state'=5) + 1/3 : (state'=6);
  [] state=6 -> 1/2 : (state'=3) + 1/2 : (state'=2);
  [] state=6 -> 1/2 : (state'=7) + 1/2 : (state'=4);
  [] state=7 -> 1/3 : (state'=9) + 1/3 : (state'=8) + 1/3 : (state'=6);
endmodule
