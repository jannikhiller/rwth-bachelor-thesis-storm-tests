smg

global state : [0..2];

player p1 [a1] endplayer
player p2 [a2] endplayer
player p3 [a3] endplayer

module all
	[a1] state=0 -> 1/2 : (state'=1) + 1/2 : (state'=2);
	[a1] state=0 -> true;
	[a2] state=1 -> 1/2 : (state'=0) + 1/2 : (state'=2);
	[a2] state=1 -> true;
	[a3] state=2 -> 1/2 : (state'=0) + 1/2 : (state'=1);
	[a3] state=2 -> true;
endmodule
