digraph model {
	0 [ label = "0[state=0]: {init}" ];
	1 [ label = "1[state=1]: {}" ];
	2 [ label = "2[state=2]: {}" ];
	3 [ label = "3[state=4]: {}" ];
	4 [ label = "4[state=5]: {(state >= 5)}" ];
	5 [ label = "5[state=3]: {}" ];
	"0c0" [shape = "point"];
	0 -> "0c0";
	"0c0" -> 1 [ label= "1" ];
	"0c1" [shape = "point"];
	0 -> "0c1";
	"0c1" -> 1 [ label= "0.5" ];
	"0c1" -> 2 [ label= "0.5" ];
	"0c2" [shape = "point"];
	0 -> "0c2";
	"0c2" -> 1 [ label= "0.5" ];
	"0c2" -> 3 [ label= "0.5" ];
	"0c3" [shape = "point"];
	0 -> "0c3";
	"0c3" -> 1 [ label= "0.5" ];
	"0c3" -> 4 [ label= "0.5" ];
	"0c4" [shape = "point"];
	0 -> "0c4";
	"0c4" -> 5 [ label= "1" ];
	"1c0" [shape = "point"];
	1 -> "1c0";
	"1c0" -> 5 [ label= "1" ];
	"1c1" [shape = "point"];
	1 -> "1c1";
	"1c1" -> 3 [ label= "0.5" ];
	"1c1" -> 5 [ label= "0.5" ];
	"2c0" [shape = "point"];
	2 -> "2c0";
	"2c0" -> 4 [ label= "1" ];
	"2c1" [shape = "point"];
	2 -> "2c1";
	"2c1" -> 0 [ label= "1" ];
	"3c0" [shape = "point"];
	3 -> "3c0";
	"3c0" -> 3 [ label= "1" ];
	"4c0" [shape = "point"];
	4 -> "4c0";
	"4c0" -> 3 [ label= "1" ];
	"5c0" [shape = "point"];
	5 -> "5c0";
	"5c0" -> 2 [ label= "1" ];
}
